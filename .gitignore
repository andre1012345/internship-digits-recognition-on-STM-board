# STM32CubeIDE build outputs
**/STM32CubeIDE/Debug/
**/STM32CubeIDE/ModelZoo/
**/STM32CubeIDE/.settings/

# Compiler artifacts
*.o
*.d
*.su
*.cyclo
*.map
*.list

# IDE workspace metadata (generated, not project source)
.metadata/
.claude/


# STM32CubeIDE launch configurations (machine-specific)
*.launch

# Flash tool — install from STM32CubeProgrammer, don't commit
STM32_Programmer_CLI.exe

# STM32CubeIDE — ST-provided library trees (not project code, multi-hundred MB)
**/STM32CubeIDE/Drivers/
**/STM32CubeIDE/Middlewares/
**/STM32CubeIDE/ll_aton/
**/STM32CubeIDE/Utilities/
**/STM32CubeIDE/Application/

# IDE project/workspace metadata (machine-specific)
.project
.cproject
makefile.targets

# ...but keep the CubeIDE project of the application, so a fresh clone can be
# imported and built (paths inside are relative to the project folder)
!Application/STM32CubeIDE/.project
!Application/STM32CubeIDE/.cproject
!Application/STM32CubeIDE/makefile.targets
!Application/STM32CubeIDE/STM32N6570-DK_GettingStarted_ImageClassification.launch
